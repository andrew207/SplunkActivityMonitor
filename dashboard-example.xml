<form version="1.1" theme="light">
  <label>Windows Activity Monitor</label>
  <fieldset submitButton="false">
    <input type="time" token="token_time">
      <label></label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <single>
        <title>Monitored Hosts Seen</title>
        <search>
          <query>| tstats dc(host) where index=* AND sourcetype=WindowsActivityMonitor:*</query>
          <earliest>$token_time.earliest$</earliest>
          <latest>$token_time.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Hosts with USB activity</title>
        <search>
          <query>index=* sourcetype=WindowsActivityMonitor:USB action=* | stats dc(host)</query>
          <earliest>$token_time.earliest$</earliest>
          <latest>$token_time.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Users Seen</title>
        <search>
          <query>index=* AND sourcetype=WindowsActivityMonitor:WindowChange | stats dc(user)</query>
          <earliest>$token_time.earliest$</earliest>
          <latest>$token_time.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <chart>
        <title>Applications Seen</title>
        <search>
          <query>index=* sourcetype=WindowsActivityMonitor:WindowChange | stats count by name</query>
          <earliest>$token_time.earliest$</earliest>
          <latest>$token_time.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>User Activity</title>
      <chart>
        <title>User Activity</title>
        <search>
          <query>index=* AND sourcetype=WindowsActivityMonitor:WindowChange | timechart count by user</query>
          <earliest>$token_time.earliest$</earliest>
          <latest>$token_time.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Application Activity</title>
      <chart>
        <search>
          <query>index=* AND sourcetype=WindowsActivityMonitor:WindowChange | timechart count by name</query>
          <earliest>$token_time.earliest$</earliest>
          <latest>$token_time.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Applications and Versions</title>
      <table>
        <search>
          <query>index=* sourcetype=WindowsActivityMonitor:WindowChange | stats count values(title) as titles values(version) min(_time) as first_seen, max(_time) as last_seen by user, name, directory
| eval first_seen = strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen = strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| sort 0 - count</query>
          <earliest>$token_time.earliest$</earliest>
          <latest>$token_time.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>USB Activity</title>
      <table>
        <search>
          <query>index=* AND sourcetype=WindowsActivityMonitor:USB action=* 
| fillnull host fullpath sha256 name deviceid value="" 
``` dedup required as copy sometimes has double ups ```
| dedup host name fullpath, sha256 
| table _time, host, action, name lastuser size fullpath sha1 sha256, deviceid</query>
          <earliest>$token_time.earliest$</earliest>
          <latest>$token_time.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </table>
    </panel>
  </row>
</form>